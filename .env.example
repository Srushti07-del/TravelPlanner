# =============================================================
# Adaptive AI Travel Planner — Environment Variables Template
# =============================================================
# Copy this file and rename it to .env in the backend/ folder
# and .env.local in the frontend/ folder.
# Then fill in the actual values for each key.
# =============================================================

# ---------------------------------------------------------------
# BACKEND (backend/.env)
# ---------------------------------------------------------------

# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL and Service Role Key (backend uses service key for full access)
# Get from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Supabase JWT Secret (used to verify user tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# OpenWeatherMap API Key (free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# FRONTEND (frontend/.env.local)
# ---------------------------------------------------------------

# Supabase (use anon/public key here, NOT the service key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------
# NOTE: No Google Maps / Places / Distance Matrix API key is
# required. This project uses free, open-source alternatives:
#   - Nominatim (OpenStreetMap) for geocoding
#   - Overpass API for nearby place discovery
#   - OSRM for routing / distance calculations
#   - Leaflet + OpenStreetMap for the frontend map
# ---------------------------------------------------------------
