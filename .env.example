# =============================================================
# Adaptive AI Travel Planner — Environment Variables Template
# =============================================================
# Copy this file and rename it to .env in the backend/ folder
# and .env.local in the frontend/ folder.
# Then fill in the actual values for each key.
# =============================================================

# ---------------------------------------------------------------
# BACKEND (backend/.env)
# ---------------------------------------------------------------

# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL and Service Role Key (backend uses service key for full access)
# Get from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Google Maps / Places API Key
# Enable: Maps JavaScript API, Places API, Distance Matrix API
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap API Key (free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# FRONTEND (frontend/.env.local)
# ---------------------------------------------------------------

# Supabase (use anon/public key here, NOT the service key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps JavaScript API Key (same key as backend, or a restricted browser key)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
